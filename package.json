{
  "name": "ideagit",
  "version": "0.1.0",
  "description": "MCP server that records why decisions were made, in your repo, so your coding agent can read them back.",
  "type": "module",
  "bin": {
    "ideagit": "./bin/ideagit.js"
  },
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.js",
    "review": "node bin/ideagit.js review",
    "rules": "node bin/ideagit.js rules",
    "prepublishOnly": "npm test",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "files": [
    "dist",
    "bin",
    "hooks",
    "prompts"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
